# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Domain Configuration
VITE_APP_DOMAIN=roohpro.com

# Admin Email Management
VITE_ADMIN_EMAILS=rooh10dodo@gmail.com,roohpro1@gmail.com

# Developer Control Panel Security Code
VITE_DEV_VERIFICATION_CODE=5030775

# Firebase Backend Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=ai-studio-applet-webapp-81560.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://ai-studio-applet-webapp-81560-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=ai-studio-applet-webapp-81560
VITE_FIREBASE_STORAGE_BUCKET=ai-studio-applet-webapp-81560.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# AI Core & Multi-Engine Credentials
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY
VITE_HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_API_KEY

# Cloudflare Ecosystem & Deployment Configuration (Stored in GitHub Secrets / Cloudflare Dashboard)
# 1. Cloudflare Authentication Secrets for GitHub Actions CI/CD (both names supported):
CLOUDFLARE_API_TOKEN=
CF_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_ACCOUNT_ID=

# 2. Cloudflare R2 Media & Pages Bucket:
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=roohme

# 3. Cloudflare D1 SQL Database:
CLOUDFLARE_D1_DATABASE_ID=YOUR_CLOUDFLARE_D1_DATABASE_ID

# 4. Cloudflare KV Edge Namespace:
CLOUDFLARE_KV_NAMESPACE_ID=YOUR_CLOUDFLARE_KV_NAMESPACE_ID

# 5. Production Domain, API Endpoints & Mock Data Isolation Switch
VITE_BASE_DOMAIN=https://roohpro.com
VITE_APP_PATH=/ai
VITE_API_ENDPOINT=/ai/api/v1
# Set to 'true' in production or when connected to live Cloudflare Worker D1/R2 to completely disable mock data
VITE_USE_LIVE_API=false